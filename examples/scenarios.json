{
  "AccessPath": {
    "writes": [
      {
        "id": "report",
        "method": "assess",
        "signer": "operator",
        "args": [
          "CivicWorks demo library",
          "West entrance route",
          "The West entrance route is step-free. An accessible restroom is reachable on the West entrance route. No lift serves the West entrance route."
        ]
      }
    ],
    "reads": [
      {
        "method": "get_report",
        "args": [
          {
            "result": "report"
          }
        ],
        "expected": {
          "features": {
            "step_free_entry": "YES",
            "accessible_restroom": "YES",
            "lift_serves_route": "NO"
          }
        }
      }
    ]
  },
  "WorksConflict": {
    "writes": [
      {
        "id": "comparison",
        "method": "compare",
        "signer": "operator",
        "args": [
          "Oak Avenue between Maple Street and River Drive",
          30000010,
          30000070,
          true,
          "The segment of Oak Avenue from Maple Street to River Drive",
          30000040,
          30000100,
          true
        ]
      }
    ],
    "reads": [
      {
        "method": "get_check",
        "args": [
          {
            "result": "comparison"
          }
        ],
        "expected": {
          "overlap_minutes": 30,
          "location_relation": "SAME",
          "outcome": "FULL_CONFLICT"
        }
      }
    ]
  },
  "RepairMerge": {
    "writes": [
      {
        "id": "primary",
        "method": "file_report",
        "signer": "operator",
        "args": [
          {
            "scenario": "LIB"
          },
          30000000,
          "Door D2 has a jammed closer and stops halfway shut."
        ]
      },
      {
        "id": "duplicate",
        "method": "file_report",
        "signer": "operator",
        "args": [
          {
            "scenario": "LIB"
          },
          30000010,
          "The same door D2 stops halfway when closing because its closer jams."
        ]
      },
      {
        "id": "review",
        "method": "review_duplicate",
        "signer": "operator",
        "args": [
          {
            "result": "duplicate"
          },
          {
            "result": "primary"
          }
        ]
      }
    ],
    "reads": [
      {
        "method": "get_report",
        "args": [
          {
            "result": "duplicate"
          }
        ],
        "expected": {
          "duplicate_of": {
            "result": "primary"
          }
        }
      },
      {
        "method": "get_report",
        "args": [
          {
            "result": "primary"
          }
        ],
        "expected": {
          "linked_reports": 1
        }
      }
    ]
  },
  "NoticeClock": {
    "writes": [
      {
        "id": "notice",
