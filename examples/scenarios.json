        ]
      },
      {
        "id": "inspection",
        "method": "inspect",
        "signer": "recipient",
        "args": [
          {
            "result": "offer"
          },
          "All four wheels turn freely. A new 10 centimeter crack is visible on the front handle."
        ]
      },
      {
        "id": "resolution",
        "method": "resolve_exception",
        "signer": "operator",
        "args": [
          {
            "result": "offer"
          },
          true,
          "Accept with the handle crack recorded for repair."
        ]
      }
    ],
    "reads": [
      {
        "method": "get_handoff",
        "args": [
          {
            "result": "offer"
          }
        ],
        "expected": {
          "assessment": "CHANGED",
          "status": "ACCEPTED_WITH_EXCEPTION"
        }
      }
    ]
  },
  "DonationAllocation": {
    "writes": [
      {
        "id": "channel",
        "method": "open_channel",
        "signer": "operator",
        "args": [
          {
            "scenario": "chairs"
          },
          "All chairs must be intact with all four feet attached.",
          10
        ]
      },
      {
        "id": "lot",
        "method": "submit_lot",
        "signer": "operator",
        "args": [
          {
            "result": "channel"
          },
          {
            "scenario": "LOT-1"
          },
          6,
          "All six chairs are intact and all four feet of each chair are attached."
        ]
      },
      {
        "id": "reserve",
        "method": "reserve",
        "signer": "operator",
        "args": [
          {
            "result": "lot"
          }
        ]
      },
      {
        "id": "complete",
        "method": "complete",
        "signer": "operator",
        "args": [
          {
            "result": "lot"
          },
          true
        ]
      }
    ],
    "reads": [
      {
        "method": "get_channel",
        "args": [
          {
            "result": "channel"
          }
        ],
        "expected": {
          "remaining": 4,
          "reserved": 0,
          "distributed": 6
        }
      },
      {
        "method": "get_lot",
        "args": [
          {
            "result": "lot"
          }
        ],
        "expected": {
          "state": "DISTRIBUTED"
        }
      }
    ]
  },
